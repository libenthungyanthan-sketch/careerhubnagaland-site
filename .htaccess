Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# www.careerhubnagaland.in -> careerhubnagaland.in
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteRule ^_data/ - [F,L]
RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# Old Website Builder addresses
RedirectMatch 301 ^/book-your-session(-1|-2)?/?$ /fees/
RedirectMatch 301 ^/privacy-policy-parental-consent-career-counselling/?$ /privacy/
RedirectMatch 301 ^/terms-and-conditions-cookies/?$ /terms/

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/x-icon "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
